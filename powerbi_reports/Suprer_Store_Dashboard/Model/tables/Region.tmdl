table Region

	column ID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ID

		annotation SummarizationSetBy = Automatic

	column Region
		dataType: string
		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = Automatic

	partition Region = m
		mode: import
		source =
				let
				    Source = Sql.Databases("sql-server-powerbi.database.windows.net"),
				    Super_Store_Data = Source{[Name="Super_Store_Data"]}[Data],
				    dbo_Region = Super_Store_Data{[Schema="dbo",Item="Region"]}[Data]
				in
				    dbo_Region

	annotation PBI_ResultType = Table

