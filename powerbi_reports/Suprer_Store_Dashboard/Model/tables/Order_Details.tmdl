table Order_Details

	measure 'Total Sales' = ```
			
			SUM ( Order_Details[Sales] )
			
			```
		formatString: \$#,0;(\$#,0);\$#,0

	measure 'Total Profit' = ```
			
			SUM ( Order_Details[Profit] )
			
			```
		formatString: \$#,0;(\$#,0);\$#,0

	measure 'Total Quantity' = ```
			
			SUM ( Order_Details[Quantity] )
			
			```
		formatString: 0

	measure 'Profit Margin %' = ```
			
			DIVIDE ( [Total Profit], [Total Sales], 0 )
			
			```
		formatString: 0.00%;-0.00%;0.00%

	measure 'Product Rank' = ```
			
			RANKX (
			    ALL ( Order_Details[Product_Name] ),
			    [Total Sales],
			    ,
			    DESC
			)
			
			```
		formatString: 0

	measure 'Customer Count' = DISTINCTCOUNT(Order_Details[Customer_ID])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Orders =
			
			DISTINCTCOUNT ( Order_Details[Order_ID])
		formatString: 0

	measure 'High Discount Flag' = ```
			
			IF (
			    AVERAGE ( Order_Details[Discount] ) > 0.3,
			    "High Discount",
			    "Normal"
			)
			
			```

	measure 'Total returns' = COUNT ( Returns[Order_ID] )
		formatString: 0

	measure 'Avg Discount' = AVERAGE(Order_Details[Discount])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

