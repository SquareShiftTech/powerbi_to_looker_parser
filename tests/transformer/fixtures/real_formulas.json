  {
    "name": "Global Marketing & Custome_ad094011 | marketing_campaign_data.Channel Conversion Rate %",
    "dax": "VAR Conv =\n    CALCULATE(\n        SUM('marketing_campaign_data'[Conversions]),\n        ALLEXCEPT('marketing_campaign_data', 'marketing_campaign_data'[Channel])\n    )\nVAR Cust =\n    CALCULATE(\n        DISTINCTCOUNT('marketing_campaign_data'[CustomerID]),\n        ALLEXCEPT('marketing_campaign_data', 'marketing_campaign_data'[Channel])\n    )\nRETURN\nDIVIDE(Conv, Cust, 0)",
