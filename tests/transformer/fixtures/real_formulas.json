  {
    "name": "Global Marketing & Custome_ad094011 | marketing_campaign_data.Avg Revenue per Customer",
    "dax": "VAR custs =\n    SUMMARIZE(\n        'marketing_campaign_data',\n        'marketing_campaign_data'[CustomerID],\n        \"Exposures\", DISTINCTCOUNT('marketing_campaign_data'[CampaignID]),\n        \"Revenue\", SUM('marketing_campaign_data'[Revenue])\n    )\nVAR summary =\n    SUMMARIZE(\n        custs,\n        [Exposures],\n        \"AvgRevenue\", AVERAGEX(custs, [Revenue])\n    )\nRETURN\nAVERAGEX(summary, [AvgRevenue])",
    "resolution_map": {}
