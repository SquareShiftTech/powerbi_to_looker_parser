  {
    "name": "Global Marketing & Custome_ad094011 | campaign_products.Customers Who Converted",
    "dax": "CALCULATE(\n    DISTINCTCOUNT('marketing_campaign_data'[CustomerID]),\n    FILTER('marketing_campaign_data', 'marketing_campaign_data'[Conversions] > 0)\n)",
    "resolution_map": {}
  },
  {
    "name": "Global Marketing & Custome_ad094011 | campaign_products.Conversions per Customer",
    "dax": "SUMX(\n    FILTER(VALUES(marketing_campaign_data[CustomerID]), \n        CALCULATE(SUM(marketing_campaign_data[Conversions])) > 0),\n    1\n)",
    "resolution_map": {}
  },
  {
    "name": "Global Marketing & Custome_ad094011 | campaign_products.Conversion Rate by Exposure",
    "dax": "VAR custs =\n    SUMMARIZE(\n        'marketing_campaign_data',\n        'marketing_campaign_data'[CustomerID],\n        \"Exposures\", DISTINCTCOUNT('marketing_campaign_data'[CampaignID]),\n        \"ConvertedFlag\", IF(SUM('marketing_campaign_data'[Conversions]) > 0, 1, 0)\n    )\nVAR summary =\n    SUMMARIZE(\n        custs,\n        [Exposures],\n        \"TotalCustomers\", COUNTROWS(custs),\n        \"ConvertedCustomers\", SUMX(custs, [ConvertedFlag])\n    )\nRETURN\nAVERAGEX(summary, DIVIDE([ConvertedCustomers], [TotalCustomers]))",
    "resolution_map": {}
  },
  {
    "name": "Global Marketing & Custome_ad094011 | marketing_campaign_data.Campaigns Exposed1",
    "dax": "CALCULATE(\n    DISTINCTCOUNT(marketing_campaign_data[CampaignID]),\n    ALLEXCEPT(marketing_campaign_data, marketing_campaign_data[CustomerID])\n)",
    "resolution_map": {}
