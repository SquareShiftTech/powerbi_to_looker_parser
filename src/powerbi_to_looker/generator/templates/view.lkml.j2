{# View: one view per artifact view. Measures: two_step = hidden dimension + measure; one_step = single measure (type: number, sql: formula). #}
view: {{ view.view_name }} {

  {%- if view.sql_table_name %}
  sql_table_name: {{ view.sql_table_name }} ;;
  {%- elif view.derived_table_sql %}
  derived_table: {
    sql: {{ view.derived_table_sql }} ;;
  }
  {%- endif %}

  {%- for field in view.fields %}
  {%- if field.field_type == 'measure' and field.measure_pattern == 'two_step' %}
  {# Two-step: hidden dimension with sql, measure points to it with type from aggregation #}
  dimension: {{ field.field_name }}_measure {
    type: number
    hidden: yes
    {%- if field.conversion_status == 'manual' %}
    {%- set _manual_desc = "Original DAX: " ~ (field.original_formula | comment_dax_lines) ~ "\n" ~ "[MANUAL REVIEW REQUIRED]" ~ ("\nReason: " ~ field.message if field.message else "") %}
    description: "{{ _manual_desc | description_quote_escape }}"
    sql: NULL ;;
    {%- else %}
    {%- if field.original_formula %}
    # Original DAX: {{ field.original_formula | comment_dax_lines }}
    {%- if field.conversion_status == 'partial' %}
    # Converted: {{ field.conversion_status }}
    {%- endif %}
    {%- endif %}
    sql: {{ (field.sql if field.sql else '""') | sql_quote_table_column }} ;;
    {%- endif %}
    {%- if field.value_format %}
    value_format_name: {{ field.value_format }}
    {%- endif %}
  }

  measure: {{ field.field_name }} {
    type: {{ field.looker_type }}
    sql: ${ {{- field.field_name -}}_measure} ;;
    {%- if field.value_format %}
    value_format_name: {{ field.value_format }}
    {%- endif %}
    {%- if field.label %}
    label: "{{ field.label | replace('"', '\\"') }}"
    {%- endif %}
  }
  {%- elif field.field_type == 'measure' %}
  {# One-step measure (or fallback when measure_pattern not set): type number, sql = translated DAX #}
  measure: {{ field.field_name }} {
    type: number
    {%- if field.conversion_status == 'manual' %}
    {%- set _manual_desc = "Original DAX: " ~ (field.original_formula | comment_dax_lines) ~ "\n" ~ "[MANUAL REVIEW REQUIRED]" ~ ("\nReason: " ~ field.message if field.message else "") %}
    description: "{{ _manual_desc | description_quote_escape }}"
    sql: NULL ;;
    {%- else %}
    {%- if field.original_formula %}
    # Original DAX: {{ field.original_formula | comment_dax_lines }}
    {%- if field.conversion_status == 'partial' %}
    # Converted: {{ field.conversion_status }}
    {%- endif %}
    {%- endif %}
    sql: {{ (field.sql if field.sql else '""') | sql_quote_table_column }} ;;
    {%- endif %}
    {%- if field.value_format %}
    value_format_name: {{ field.value_format }}
    {%- endif %}
    {%- if field.label %}
    label: "{{ field.label | replace('"', '\\"') }}"
    {%- endif %}
  }
  {%- elif field.field_type == 'dimension_group' %}
  dimension_group: {{ field.field_name }} {
    type: {{ field.looker_type }}
    timeframes: [{{ (field.timeframes or []) | join(', ') }}]
    sql: {{ field.sql | sql_quote_table_column }} ;;
    {%- if field.label %}
    label: "{{ field.label | replace('"', '\\"') }}"
    {%- endif %}
  }
  {%- else %}
  dimension: {{ field.field_name }} {
    type: {{ field.looker_type }}
    {%- if field.conversion_status == 'manual' %}
    {%- set _dax_bit = ("Original DAX: " ~ (field.original_formula | comment_dax_lines) ~ "\n") if field.original_formula else "" %}
    {%- set _manual_desc = _dax_bit ~ "[MANUAL REVIEW REQUIRED]" ~ ("\nReason: " ~ field.message if field.message else "") %}
    description: "{{ _manual_desc | description_quote_escape }}"
    sql: NULL ;;
    {%- else %}
    {%- if field.original_formula %}
    # Original DAX: {{ field.original_formula | comment_dax_lines }}
    {%- if field.conversion_status == 'partial' %}
    # Converted: {{ field.conversion_status }}
    {%- endif %}
    {%- endif %}
    sql: {{ field.sql | sql_quote_table_column }} ;;
    {%- endif %}
    {%- if field.label %}
    label: "{{ field.label | replace('"', '\\"') }}"
    {%- endif %}
  }
  {%- endif %}
  {%- endfor %}
}
