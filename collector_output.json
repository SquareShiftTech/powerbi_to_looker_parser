                },
                {
                  "name": "Customer Count",
                  "expression": "DISTINCTCOUNT(Order_Details[Customer_ID])",
                  "isHidden": false
                },
                {
                  "name": "Total_Orders",
                  "expression": "\nDISTINCTCOUNT ( Order_Details[Order_ID])",
                  "isHidden": false
                },
                {
                  "name": "High Discount Flag",
                  "expression": "\nIF (\n    AVERAGE ( Order_Details[Discount] ) > 0.3,\n    \"High Discount\",\n    \"Normal\"\n)\n",
                  "isHidden": false
                },
                {
                  "name": "Total returns",
                  "expression": "COUNT ( Returns[Order_ID] )",
                  "isHidden": false
                },
                {
                  "name": "Avg Discount",
                  "expression": "AVERAGE(Order_Details[Discount])",
                  "isHidden": false
                }
              ],
