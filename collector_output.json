              "measures": [
                {
                  "name": "Total Sales",
                  "expression": "\nSUM ( Order_Details[Sales] )\n",
                  "isHidden": false
                },
                {
                  "name": "Total Profit",
                  "expression": "\nSUM ( Order_Details[Profit] )\n",
                  "isHidden": false
                },
                {
                  "name": "Total Quantity",
                  "expression": "\nSUM ( Order_Details[Quantity] )\n",
                  "isHidden": false
                },
                {
                  "name": "Profit Margin %",
                  "expression": "\nDIVIDE ( [Total Profit], [Total Sales], 0 )\n",
                  "isHidden": false
                },
                {
                  "name": "Product Rank",
                  "expression": "\nRANKX (\n    ALL ( Order_Details[Product_Name] ),\n    [Total Sales],\n    ,\n    DESC\n)\n",
                  "isHidden": false
                },
                {
                  "name": "Customer Count",
                  "expression": "DISTINCTCOUNT(Order_Details[Customer_ID])",
                  "isHidden": false
                },
                {
                  "name": "Total_Orders",
                  "expression": "\nDISTINCTCOUNT ( Order_Details[Order_ID])",
                  "isHidden": false
                }
              ],
